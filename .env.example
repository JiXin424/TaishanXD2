# ╔══════════════════════════════════════════════════════════════════╗
# ║  TaishanXD V2 — 本地开发环境变量模板                            ║
# ║                                                                  ║
# ║  ⚠️  本地开发请复制此文件并重命名为 .env.local                    ║
# ║      cp .env.example .env.local                                  ║
# ║      且绝对不能将 .env.local 提交到版本库                        ║
# ╚══════════════════════════════════════════════════════════════════╝

# ── PostgreSQL ──────────────────────────────────────────────────
PG_HOST=localhost
PG_PORT=5433
PG_USER=taishan
PG_PASSWORD=taishan_dev
PG_DB=taishan
# 完整连接串（供 ORM 直接使用）
DATABASE_URL=postgresql://${PG_USER}:${PG_PASSWORD}@${PG_HOST}:${PG_PORT}/${PG_DB}?sslmode=disable

# ── Redis ───────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=taishan_dev
REDIS_DB=0
# 完整连接串
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# ── 应用端口 ────────────────────────────────────────────────────
# Next.js 前端
PORT_FRONTEND=3000
# Go / Spring Boot 核心网关
PORT_GATEWAY=4007
# Python FastAPI AI 微服务
PORT_AI=8000

# ── Traefik ─────────────────────────────────────────────────────
TRAEFIK_HTTP_PORT=80
TRAEFIK_DASHBOARD_PORT=8081

# ── 安全与会话 ──────────────────────────────────────────────────
SESSION_SECRET=replace-me-with-random-64-char-string
JWT_SECRET=replace-me-with-random-64-char-string

# ── 钉钉集成（占位） ────────────────────────────────────────────
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_AGENT_ID=
DINGTALK_CORP_ID=
# Stream 机器人
DINGTALK_STREAM_CLIENT_ID=
DINGTALK_STREAM_CLIENT_SECRET=

# ── AI / LLM 服务（占位） ──────────────────────────────────────
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-plus
# 可选：OpenAI 兼容接口
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ── 日志与调试 ──────────────────────────────────────────────────
LOG_LEVEL=debug
GIN_MODE=debug
